        <item>
         <widget class="QLabel" name="message">
          <property name="styleSheet">
           <string notr="true">font-size: 13px;</string>
          </property>
          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Sembra che il certificato di &lt;span style=&quot; font-weight:600;&quot;&gt;mitmproxy&lt;/span&gt; non sia installato.&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot; font-weight:600; color:#ff0000;&quot;&gt;Senza questo certificato, FIT Web non può intercettare il traffico HTTPS e quindi non può funzionare. Per questo motivo verrà chiusa.&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;Per installarlo servono i privilegi di amministratore: ti verrà richiesta la password di root (anche più volte).&lt;/p&gt;&lt;p&gt;&lt;br/&gt;Questa operazione avviene solo la prima volta. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
